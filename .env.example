# Copy to .env (in this folder or its parent) and fill in. Never commit the filled file.
# Summaries (default model: Jais 3 at MBZUAI's Institute of Foundation Models)
JAIS_API_KEY=
# MIRSAD_LLM=jais        # jais (default), falcon (local in the sandbox VM, zero egress), or off
# JAIS_MODEL=IFM/Jais-3-MoVA-36B-A4B
# FALCON_BASE_URL=http://127.0.0.1:8602/v1

# Search results and ads
SERPAPI_API_KEY=
SERPER_API_KEY=

# Map listings (Google Places API (New), Enterprise fields: website and phone)
PLACES_API_KEY=

# Reputation and labels
ABUSECH_AUTH_KEY=
VIRUSTOTAL_API_KEY=

# Training data download
KAGGLE_API_TOKEN=

# Sandbox VM (page capture and Phishpedia)
# MIRSAD_SANDBOX_URL=http://127.0.0.1:8601
# MIRSAD_CERTSTREAM_URL=ws://127.0.0.1:8603/   # local CT stream, started on this machine for each certificate run
# MIRSAD_THRESHOLD=0.80
# MIRSAD_SANDBOX_TOKEN=   # shared token, set to the same value inside the VM, to require it on every sandbox request
# MIRSAD_REDACTION_KEY=   # secret used to hash query values in stored links; a random key is made in data/ when unset

# Server modes (the public demo's Docker image sets these)
# MIRSAD_PUBLIC=1         # public demo: no raw links, no visitor addresses, plain [redacted] placeholders
# MIRSAD_SCHEDULE=1       # run feeds every hour and certificates every day inside the server
# MIRSAD_SANDBOX_URL=off  # never open suspect pages (no sandbox VM)
# MIRSAD_CERTSTREAM=off   # crt.sh only, no live certificate stream
# MIRSAD_ALLOWED_HOSTS=   # extra host names the lab server answers to, comma-separated
# MIRSAD_DB=              # another SQLite file instead of data/mirsad.sqlite3

